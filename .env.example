# Copy to .env and adjust. All optional — Conventus runs with defaults.

# The shared password everyone uses to enter the room.
ROOM_PASSWORD=conventus

# Unlocks the admin panel (channels, bots, reserved names, export/import).
ADMIN_PASSWORD=admin

# Signs session tokens. Pin it so sessions survive restarts.
SECRET_KEY=please-change-this-to-something-random

# Branding shown in the UI.
ROOM_NAME=Conventus

# Per-file upload cap in megabytes.
MAX_UPLOAD_MB=100

# Where data lives (db + uploads). On HF Spaces persistent storage: /data
# DATA_DIR=./data

# --- Assistant (optional) ---
# Point the room Assistant at an endpoint from the environment. Set both
# AGENT_ENDPOINT and AGENT_TOKEN to enable it on startup; otherwise leave them
# unset and configure it in Settings → Assistant. Any OpenAI-compatible endpoint works.
# AGENT_ENDPOINT=https://api.openai.com/v1
# AGENT_TOKEN=sk-xxxx
#
# Model, type and name are normally chosen by an admin in Settings → Assistant.
# These are optional overrides — they only apply when set and never overwrite an
# admin's Settings choices on restart.
# AGENT_MODEL=gpt-4o-mini
# AGENT_MODEL_TYPE=standard      # standard | reasoning (widens token budget)
# AGENT_NAME=Assistant
