# Copy to .env and adjust. All optional — Conventus runs with defaults.

# The shared password everyone uses to enter the room.
ROOM_PASSWORD=conventus

# Unlocks the admin panel (channels, bots, reserved names, export/import).
ADMIN_PASSWORD=admin

# Signs session tokens. Pin it so sessions survive restarts.
SECRET_KEY=please-change-this-to-something-random

# Branding shown in the UI.
ROOM_NAME=Conventus

# Per-file upload cap in megabytes.
MAX_UPLOAD_MB=100

# Where data lives (db + uploads). On HF Spaces persistent storage: /data
# DATA_DIR=./data
